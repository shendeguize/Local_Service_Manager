state/*
!state/.gitkeep
state/logs/*
!state/logs/.gitkeep

# Personal LocalSM configuration never belongs in the repository; the example
# is the only tracked YAML here. Real config lives in ~/.config/localsm/.
config/*.yaml
!config/*.example.yaml
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
packages/npm/wheel/
packages/npm/*.tgz

# DevolaFlow local workspace (whitelist team-collab subdirs; everything else private)
# Per feedback_for_v12.1.0.md — narrow whitelist replaces v9.2.3 broad ignore.
# Team-tracked: .local/memory/specs/ (A-4) + .local/research/ (W-7/W-19 artifacts).
.local/*
!.local/.gitignore
!.local/memory/
.local/memory/*
!.local/memory/specs/
!.local/memory/specs/**
!.local/research/
!.local/research/**
!.local/human/
.local/human/*
!.local/human/input/
!.local/human/input/**

# DevolaFlow scaffold entries (tool-local caches; safe to keep)
.codegraph/
